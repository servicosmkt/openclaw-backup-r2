# Copie este arquivo para ".env" e preencha com seus dados.
# NUNCA faca commit do .env real (ele esta no .gitignore).

# Endpoint do seu bucket R2 (Cloudflare) incluindo o nome do bucket.
# Formato: https://<accountid>.r2.cloudflarestorage.com/<seu-bucket>
# O script adiciona o prefixo "s3:" automaticamente.
RESTIC_REPOSITORY=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com/openclaw-backups

# Credenciais do R2 (R2 -> Manage API Tokens -> cria um token S3)
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
